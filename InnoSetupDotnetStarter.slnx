<Solution>
  <Folder Name="/Solution Items/">
    <File Path="Directory.Packages.props" />
    <File Path="Directory.Build.props" />
    <File Path="global.json" />
    <File Path=".editorconfig" />
    <File Path=".gitattributes" />
    <File Path=".gitignore" />
    <File Path="README.md" />
    <File Path="build/Directory.Build.props" />
    <File Path="build/Directory.Build.targets" />
  </Folder>
  <Folder Name="/build/">
    <Project Path="build/App.Build.csproj">
      <Build Project="false" />
    </Project>
  </Folder>
  <Folder Name="/installer/">
    <File Path="installer/Setup.iss" />
    <Project Path="installer/App.Installer.Tool/App.Installer.Tool.csproj">
      <Platform Solution="*|*" Project="x64" />
    </Project>
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/App.Abstractions/App.Abstractions.csproj" />
    <Project Path="src/App.Client.Windows/App.Client.Windows.csproj">
      <Platform Solution="*|*" Project="x64" />
    </Project>
    <Project Path="src/App.Domain/App.Domain.csproj" />
    <Project Path="src/App.Infrastructure/App.Infrastructure.csproj" />
    <Project Path="src/App.Updates/App.Updates.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/App.Infrastructure.Tests/App.Infrastructure.Tests.csproj" />
    <Project Path="tests/App.Updates.Tests/App.Updates.Tests.csproj" />
  </Folder>
</Solution>
