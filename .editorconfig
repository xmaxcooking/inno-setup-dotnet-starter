root = true

[*.{props,targets,csproj,sln,slnx}]
charset = utf-8

[*.cs]
indent_size = 4
indent_style = space
tab_width = 4
dotnet_diagnostic.IDE0055.severity = error
end_of_line = crlf
insert_final_newline = false
charset = utf-8
dotnet_separate_import_directive_groups = false
