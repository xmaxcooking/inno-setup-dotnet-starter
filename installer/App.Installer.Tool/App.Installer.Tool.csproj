<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain console app: Setup.iss only invokes this via ExecAndCaptureOutput now, which Inno
         Setup's own docs say always hides console programs regardless of ShowCmd - no flash risk,
         so there's no reason to give up normal console behavior for interactive/manual runs. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\App.Infrastructure\App.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

</Project>
