<Window
    x:Class="App.Client.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,*">

        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File">
                <MenuFlyoutItem x:Name="SettingsMenuItem" Text="Settings..." Click="settingsMenuItemClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="1" Padding="24" RowDefinitions="Auto,Auto,Auto,*">

            <InfoBar
                Grid.Row="0"
                x:Name="NewerMajorNotice"
                Severity="Informational"
                IsOpen="False"
                Title="A new major version is available"
                Margin="0,0,0,16" />

            <TextBlock
                Grid.Row="1"
                Text="Sample Customers"
                Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock
                Grid.Row="2"
                x:Name="CustomerCountText"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Margin="0,4,0,16" />

            <Border
                Grid.Row="3"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                <ListView x:Name="CustomersList" Padding="4" SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="8,10">
                                <PersonPicture Grid.Column="0" Width="36" Height="36" DisplayName="{Binding Name}" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap">
                                        <Run Text="{Binding Email}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Country}" />
                                        <Run Text=" · signed up " />
                                        <Run Text="{Binding SignedUpOn}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</Window>
