<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Default for local/manual builds; Fallout's packInstaller target overrides this to match
         publishRelease's Prerelease flag, so a shipped build defaults new installs to the Beta channel
         exactly when the release it came from was published as a prerelease. -->
    <InnoSetupDotnetStarterIsPrereleaseBuild Condition="'$(InnoSetupDotnetStarterIsPrereleaseBuild)' == ''">true</InnoSetupDotnetStarterIsPrereleaseBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\App.Domain\App.Domain.csproj" />
    <ProjectReference Include="..\App.Infrastructure\App.Infrastructure.csproj" />
    <ProjectReference Include="..\App.Updates\App.Updates.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="GitHubOwner" Value="xmaxcooking" />
    <AssemblyMetadata Include="GitHubRepo" Value="inno-setup-dotnet-starter" />
    <AssemblyMetadata Include="IsPrereleaseBuild" Value="$(InnoSetupDotnetStarterIsPrereleaseBuild)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <!-- dotnet publish never copies the generated <AssemblyName>.pri into the publish output for an
       unpackaged (WindowsPackageType=None) app, but WinUI's native resource loader hardcodes the
       filename "resources.pri" next to the exe - without it, the first XAML resource lookup crashes
       hard natively inside Microsoft.UI.Xaml.dll at startup. -->
  <Target Name="CopyPriFileToPublishDir" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri" DestinationFiles="$(PublishDir)resources.pri" Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
  </Target>

</Project>
